{
  "rewrites": [
    { "source": "/app", "destination": "/workspace/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/public/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
