# ── RPC endpoints ────────────────────────────────────────────────────────────
# Robinhood Chain (get one from Quicknode, Chainstack, Blockdaemon, GetBlock, or Alchemy)
RHC_WSS_URL=wss://your-rhc-endpoint/ws
RHC_HTTP_URL=https://your-rhc-endpoint

# ── Deployed StreamEscrow contract ───────────────────────────────────────────
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# ── Matcher relayer wallet (needs small ETH for gas to call recordDelivery) ──
# NEVER reuse a wallet that holds real funds.
MATCHER_PRIVATE_KEY=0xyourmatcherkey

# ── Subscriber signing key (CLI / local MCP only) ────────────────────────────
# Never put this in hosted MCP deployment. Only set for CLI or local stdio MCP.
USER_PRIVATE_KEY=0xyoursubscriberkey

# ── Watch targets ────────────────────────────────────────────────────────────
# Single ERC-20 token (backward compatible):
WATCH_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Multi-contract custom events (Pro):
#   Format: 0xContractAddress:EventName[,0xAddr2:Event2,...]
#   Example: 0xAAA:Transfer,0xBBB:Swap,0xCCC:Liquidation
#   Ticker shorthand: TSLA, AAPL, NVDA, AMZN, MSFT, GOOGL, META, MSTR, SPY, QCOM
WATCH_CONTRACTS=TSLA:Transfer

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./warden.db

# ── Workspace server ─────────────────────────────────────────────────────────
WORKSPACE_PORT=4000
